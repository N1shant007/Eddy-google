# Eddy v3 configuration. All secrets come from environment variables (Cloud Run: Variables & Secrets / Secret Manager).

# --- Access ---
EDDY_PASSCODE=                # team passcode for the login gate (required)
SESSION_SECRET=               # long random string used to sign login cookies (required)
PIPELINE_TOKEN=               # bearer token the pipeline uses for /api/pipeline/* (optional)

# --- Google Cloud (on Cloud Run these use the service account; no key files) ---
GOOGLE_CLOUD_PROJECT=cobalt-mind-422108
GOOGLE_CLOUD_LOCATION=us-central1
EDDY_BUCKET=                  # Cloud Storage bucket for audio, e.g. cobalt-mind-422108-eddy-audio
FIRESTORE_DATABASE=(default)  # Firestore database id
FIRESTORE_PREFIX=eddy_        # collection name prefix, keeps Eddy's data apart from the pipeline's

# --- AI (Gemini on Vertex AI, same project; no API key) ---
GEMINI_MODEL=gemini-2.5-flash
AI_DAILY_LIMIT=60             # AI requests per person per day

# --- Hand-off ---
DRIVE_FOLDER_ID=              # optional: also save each final mix to this Google Drive folder
PIPELINE_CALLBACK_URL=        # optional: POSTed when a final mix is ready
ALLOWED_AUDIO_HOSTS=          # comma-separated hosts the pipeline may send audio URLs from (e.g. Wondercraft's CDN host)

# --- Local development without Google Cloud ---
# EDDY_STORAGE=local          # store data and audio in ./.data instead of Firestore + Cloud Storage
PORT=8080
